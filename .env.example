# Copiar a .env y ajustar. El archivo .env NO se versiona.

# --- Base de datos propia del producto (PostgreSQL)
APP_DB_NAME=novamercado
APP_DB_USER=novamercado
APP_DB_PASSWORD=cambiar_esta_clave
APP_DB_PORT_HOST=5433

# --- MLflow
MLFLOW_PORT_HOST=5050

# --- Airflow (su base de metadatos es otra, separada de la del producto)
AIRFLOW_DB_PASSWORD=cambiar_esta_clave_airflow_db
AIRFLOW_USUARIO=novamercado
AIRFLOW_CLAVE=cambiar_esta_clave_airflow
AIRFLOW_JWT_SECRET=cambiar_este_secreto_largo_y_aleatorio
AIRFLOW_PORT_HOST=8080
